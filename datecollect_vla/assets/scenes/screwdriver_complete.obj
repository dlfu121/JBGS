# Complete KeyCollect screwdriver, authored in metres.
# Coordinate convention (identical to the screwdriver_red body frame):
#   origin  : screwdriver_red body root
#   +X      : screwdriver length direction in the OBJ authoring coordinates,
#             from handle toward shaft/tip.  In MuJoCo use the conversion
#             quat 0.707105 0 0.707108 0 shown in the README.
#   +Y/+Z   : handle cross-section axes
# Handle centre = (-0.040, 0, 0) m.
# Handle extent = X [-0.120, 0.040] m, across flats = 0.036 m.
# Shaft extent  = X [0.040, 0.240] m, radius = 0.006 m.
#
# The object is intentionally a single OBJ so it can be copied to another
# scene without separately carrying the old handle OBJ and MuJoCo cylinder.

mtllib screwdriver_complete.mtl
o screwdriver_complete

# ---------------------------------------------------------------------------
# Red hexagonal handle: regular hexagonal prism, axis along local X.
# ---------------------------------------------------------------------------
g handle
usemtl screwdriver_red
v -0.120000  0.020785  0.000000
v -0.120000  0.010393  0.018000
v -0.120000 -0.010393  0.018000
v -0.120000 -0.020785  0.000000
v -0.120000 -0.010393 -0.018000
v -0.120000  0.010393 -0.018000
v  0.040000  0.020785  0.000000
v  0.040000  0.010393  0.018000
v  0.040000 -0.010393  0.018000
v  0.040000 -0.020785  0.000000
v  0.040000 -0.010393 -0.018000
v  0.040000  0.010393 -0.018000

# End caps (outward winding) and six side faces.
f 1 3 2
f 1 4 3
f 1 5 4
f 1 6 5
f 1 2 6
f 7 8 9
f 7 9 10
f 7 10 11
f 7 11 12
f 7 12 8
f 1 2 8 7
f 2 3 9 8
f 3 4 10 9
f 4 5 11 10
f 5 6 12 11
f 6 1 7 12

